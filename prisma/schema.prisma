generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model TournamentConfig {
  id           String    @id @default("default")
  status       String    @default("setup") // setup | active | completed
  format       String    @default("compass") // compass | round-robin | two-group | americano

  /// Americano only: how many rounds of rotating partners are scheduled.
  amRounds     Int       @default(0)

  /// singles | doubles. Purely how the entrants are described and drawn on
  /// screen — the draw itself is identical either way, since an entrant is one
  /// Player row whether that is a person or a pair.
  discipline   String    @default("doubles")
  bestOfSets   Int       @default(3)
  tiebreakMode String    @default("standard") // standard | match-tiebreak | advantage | race-to-9 | race-to-16

  /// Points target for the race formats (e.g. 16 or 18). 0 = not configured,
  /// which keeps the historical defaults (9 for the points-total rule, 16 for
  /// first-to) so tournaments seeded before this existed score unchanged.
  raceTarget   Int       @default(0)

  /// The serve changes hands every N points in a race. 0 = the house default of 4.
  serveEvery   Int       @default(0)
  pin          String    @default("1234")
  startedAt    DateTime?
  createdAt    DateTime  @default(now())
}

model Player {
  id        String   @id @default(cuid())
  name      String
  seed      Int

  /// Team americano and mixicano: which of the two entry groups this player
  /// belongs to (1 or 2). The two formats use it for opposite purposes — one
  /// pairs you with your group, the other across the divide. 0 everywhere
  /// else, where players are not grouped at all.
  team      Int      @default(0)
  createdAt DateTime @default(now())

  matchesAsP1 Match[] @relation("MatchP1")
  matchesAsP2 Match[] @relation("MatchP2")
  wonMatches  Match[] @relation("MatchWinner")
  lostMatches Match[] @relation("MatchLoser")

  // Americano only — the second person on each side of a match.
  matchesAsP1Partner Match[] @relation("MatchP1Partner")
  matchesAsP2Partner Match[] @relation("MatchP2Partner")
}

model Court {
  id    Int    @id
  label String
}

model Match {
  id       String @id @default(cuid())
  bracket  String // E | W | N | S | NE | SE | NW | SW
  round    Int
  posIndex Int // 0-based position within this bracket+round, deterministic

  player1Id String?
  player2Id String?
  player1   Player? @relation("MatchP1", fields: [player1Id], references: [id])
  player2   Player? @relation("MatchP2", fields: [player2Id], references: [id])

  /// Americano only: the entrants are individuals but a match is 2 v 2, so each
  /// side is a pair. Null in every other format, where one Player row already
  /// IS the whole side (a person in singles, a standing pair in doubles).
  player1PartnerId String?
  player2PartnerId String?
  player1Partner   Player? @relation("MatchP1Partner", fields: [player1PartnerId], references: [id])
  player2Partner   Player? @relation("MatchP2Partner", fields: [player2PartnerId], references: [id])

  winnerId String?
  loserId  String?
  winner   Player? @relation("MatchWinner", fields: [winnerId], references: [id])
  loser    Player? @relation("MatchLoser", fields: [loserId], references: [id])

  status  String    @default("pending") // pending | ready | scheduled | in_progress | completed
  readyAt DateTime? // set the moment both players become known; drives FIFO court queue order

  courtId   Int?
  courtSlot String? // current | next

  // deterministic feed-forward wiring, set at skeleton-generation time
  feedWinnerMatchId String?
  feedWinnerSlot    Int?
  feedLoserMatchId  String?
  feedLoserSlot     Int?

  isBracketFinal Boolean @default(false)

  forcedEnd       Boolean @default(false)
  forcedEndReason String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  points PointEvent[]

  @@index([bracket, round])
  @@index([courtId])
}

model PointEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  seq       Int
  slot      Int // 1 or 2
  createdAt DateTime @default(now())

  /// When the coach actually tapped, as reported by their phone.
  ///
  /// `createdAt` is when the server heard about it, which is a different thing
  /// entirely once points can be queued offline — a whole outage posts in one
  /// burst, milliseconds apart. Only intervals between taps from the same
  /// device are trustworthy here, which is all that is ever compared: one court
  /// has one coach on one phone.
  tappedAt  DateTime?

  @@index([matchId, seq])
}

// ---------------------------------------------------------------------------
// Compass v2 — per-court TV control and the awards ceremony.
//
// Both tables are additive: v1 never reads them, so the existing display,
// scorer and control screens behave exactly as before. They live in Postgres
// rather than process memory (the way v1's TV scene control does) because on
// Vercel each request can land in a different lambda — a coach's "go live" tap
// has to be visible to the TV, which is a different device on a different
// request path.
// ---------------------------------------------------------------------------

model CourtStage {
  courtId Int @id

  /// "idle" = the TV shows upcoming + standings; "live" = the coach has put the
  /// court on air. The winner screen is NOT stored: it is derived from "live" +
  /// a completed active match, so it can never get stuck out of sync with the
  /// actual result (see lib/v2/stage.ts).
  stage String @default("idle")

  /// The match the TV is dedicated to while live. Kept after the match
  /// completes so the winner screen still knows what to celebrate — the match
  /// row itself loses its courtSlot the moment it finishes.
  activeMatchId String?

  coachName String?

  rev       Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Ceremony {
  id String @id @default("default")

  /// idle | standby | revealing | complete
  stage String @default("idle")

  /// Places to announce, in reveal order — e.g. [3,2,1], or [2,1] when there
  /// are no third-place medals. Chosen by the organiser before the ceremony.
  places Json @default("[]")

  /// Index into `places` of the award currently on screen. -1 = nothing
  /// revealed yet (the "standby" holding screen).
  cursor Int @default(-1)

  /// Frozen podium, captured when the ceremony starts, so a late score
  /// correction can't reshuffle the names mid-presentation.
  awards Json @default("[]")

  /// Ceremony music on the court TVs, switched from the announcer's remote —
  /// they are the one person who knows whether the PA is already playing.
  soundOn Boolean @default(true)

  /// Set once the presentation has reached the full podium. After that the
  /// court screens show the final standings instead of "awaiting the results" —
  /// the placings are public by then, and that table is what players photograph.
  announced Boolean @default(false)

  rev       Int      @default(0)
  updatedAt DateTime @updatedAt
}
